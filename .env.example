# Шаблон переменных окружения. Скопировать в .env и заполнить реальными значениями.
# Не тестировался запуском проекта — состав переменных соответствует docs/DEPLOYMENT.md,
# но реальный список может уточниться в процессе разработки.

# --- Django ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://gl_news:change-me@db:5432/gl_news
# Базовый URL бэкенда для абсолютных ссылок в письмах модерации (не skidiscoverer.ru — это
# лендинг на Тильде, а не адрес этого сервиса).
SITE_BASE_URL=https://change-me.example.com

# --- Celery / Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# --- Telegram публикация ---
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHANNEL_ID=change-me

# --- LLM-редактор: GigaChat (тариф для физлица, уровень Pro — см. docs/TECH_STACK.md, п.5а) ---
# Ключ/авторизационные данные получаются в личном кабинете developers.sber.ru. Конкретный способ
# получения токена (OAuth client_id/client_secret vs authorization_key) и способ хранения —
# работа кодера, см. docs/CODER_INSTRUCTIONS.md, этап 3.
GIGACHAT_CREDENTIALS=change-me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Verify current model name at request time — модели/названия могут обновиться, см.
# docs/TECH_STACK.md, п.5а (GigaChat-Pro / GigaChat-2-Pro).
GIGACHAT_MODEL=GigaChat-2-Pro

# --- Email-модерация новостей (см. docs/DATA_MODEL.md, «Модерация по email и очередь публикации») ---
# Секретный ключ для подписи ссылок-действий (django.core.signing) — можно переиспользовать
# Django SECRET_KEY, но лучше отдельный, чтобы не связывать инвалидацию токенов с ротацией
# основного секрета.
MODERATION_SIGNING_KEY=change-me
MODERATION_EMAIL_TO=info@skidiscoverer.ru
# Провайдер выбран 07.09.2026: UniSender Go (транзакционные письма) через django-anymail —
# тот же UniSender, что уже используется в проекте skidiscoverer для рассылок (см. корневой
# CLAUDE.md), новый сервис не заводится. См. docs/TECH_STACK.md, п.5б.
ANYMAIL_UNISENDER_GO_API_KEY=change-me
# Датацентр аккаунта (09.09.2026, доке anymail.dev — без URL письмо не уйдёт, одного ключа
# недостаточно). Смотреть в адресной строке при логине в личный кабинет UniSender Go: go1 или go2.
ANYMAIL_UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1/
DEFAULT_FROM_EMAIL=info@skidiscoverer.ru

# --- Интеграция с ЛК участника клуба (см. docs/INTEGRATION_LK.md) ---
# Токен, который ЛК передаёт в заголовке Authorization: Bearer <...> при запросах к нашему API.
# Один токен на весь бэкенд (news + knowledge_base + consultations), см. INTEGRATION_LK.md.
LK_API_TOKEN=change-me
# Опционально, только когда включаем push-вебхук (этап 6 в docs/CODER_INSTRUCTIONS.md).
LK_WEBHOOK_URL=

# --- Приём заявок с формы на Тильде (см. docs/CONSULTATIONS.md) ---
# Отдельный токен, если Тильда не может слать кастомный заголовок Authorization — тогда
# используется как query-параметр в URL вебхука. Уточнить на реальном лендинге перед вводом в бой.
FORMS_API_TOKEN=change-me

# --- Уведомления менеджеру о новых заявках на консультацию (см. docs/CONSULTATIONS.md) ---
MANAGER_TELEGRAM_CHAT_ID=change-me

# --- Файловое хранилище для документов knowledge_base (продакшен, см. TECH_STACK.md п.8) ---
# Оставить пустым для локальной разработки (используется локальный диск/volume).
S3_STORAGE_ENDPOINT=
S3_STORAGE_BUCKET=
S3_STORAGE_ACCESS_KEY=
S3_STORAGE_SECRET_KEY=
